{
  "name": "download-artifact",
  "version": "8.0.2",
  "description": "Download an Actions Artifact from a workflow run",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "release": "ncc build src/download-artifact.ts && git add -f dist/",
    "check-all": "concurrently \"npm:format-check\" \"npm:lint\" \"npm:build\"",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint **/*.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions/download-artifact.git"
  },
  "keywords": [
    "Actions",
    "GitHub",
    "Artifacts",
    "Download"
  ],
  "author": "GitHub",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/actions/download-artifact/issues"
  },
  "homepage": "https://github.com/actions/download-artifact#readme",
  "dependencies": {
    "@actions/artifact": "^6.3.1",
    "@actions/core": "^3.0.0",
    "minimatch": "10.2.6"
  },
  "devDependencies": {
    "@actions/github": "^9.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.1.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vercel/ncc": "^0.38.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-github": "^6.0.0",
    "eslint-plugin-jest": "^29.12.1",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "uri-js": "npm:uri-js-replace@^1.0.1",
    "@isaacs/brace-expansion@5": "5.0.1",
    "brace-expansion@2": "2.1.7",
    "fast-xml-parser@5": "5.11.2",
    "minimatch@9": "9.0.9",
    "lodash@4": "4.18.1",
    "minimatch@10": "10.2.6",
    "minimatch@5": "5.1.9",
    "undici@6": "6.29.1",
    "@babel/core@7": "7.29.7",
    "@humanfs/node@0": "0.17.0",
    "ajv@6": "6.15.0",
    "baseline-browser-mapping@2": "2.11.33",
    "brace-expansion@1": "1.1.21",
    "browserslist@4": "4.29.5",
    "flatted@3": "3.4.4",
    "handlebars@4": "4.7.10",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "minimatch@3": "3.1.5",
    "picomatch@2": "2.3.2",
    "picomatch@4": "4.0.7",
    "shell-quote@1": "1.12.0"
  }
}
